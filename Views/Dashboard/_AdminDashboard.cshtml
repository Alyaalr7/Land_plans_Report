@using Land_plans_Report.Data
@using Land_plans_Report.Helpers
@using Land_plans_Report.Models
@model List<Report>
@{
    // عرض فقط: كل الأرقام تجي من DashboardController (ViewBag.Admin)
    var d = ViewBag.Admin as AdminDashboardData ?? new AdminDashboardData();
    int chartMax = Math.Max(1, d.Months.Select(m => Math.Max(m.First, m.Second)).DefaultIfEmpty(0).Max());
    int typeMax = Math.Max(1, d.ByType.Select(t => t.Count).DefaultIfEmpty(0).Max());
    int ready = d.SigningUsers - d.MissingSignatures.Count;

    string DaysText(int n) => n <= 0 ? "اليوم" : n == 1 ? "يوم واحد" : n == 2 ? "يومان" : n <= 10 ? $"{n} أيام" : $"{n} يوماً";

    string Responsible(string type) =>
        d.ApproverRoleNames.TryGetValue(type == "plan" ? "PlanApprover" : "PlotApprover", out var n) ? n : "";
}

<div class="dash">

    <div class="page-head">
        <h1 class="dash-title">لوحة التحكم</h1>
        <span class="page-meta">@DateDisplay.Date(DateTime.Today)</span>
    </div>

    <!-- إجراءات سريعة -->
    <div class="action-grid">
        <a class="action-card" asp-controller="Users" asp-action="Create">
            <span class="action-icon"><svg class="ico"><use href="#i-users" /></svg></span>
            <span><strong>إضافة مستخدم</strong><small>حساب جديد وتحديد دوره</small></span>
        </a>
        <a class="action-card" asp-controller="Signatures" asp-action="Index">
            <span class="action-icon"><svg class="ico"><use href="#i-stamp" /></svg></span>
            <span><strong>إضافة توقيع أو ختم</strong><small>رفع صورة وتفعيلها</small></span>
        </a>
        <a class="action-card" asp-controller="AuditLog" asp-action="Index">
            <span class="action-icon"><svg class="ico"><use href="#i-file" /></svg></span>
            <span><strong>سجل التدقيق</strong><small>كل العمليات في النظام</small></span>
        </a>
    </div>

    <!-- المؤشرات -->
    <div class="stat-grid">
        <div class="stat-card is-static">
            <span class="stat-icon is-info"><svg class="ico"><use href="#i-file" /></svg></span>
            <span class="stat-label">التقارير المرسلة</span>
            <span class="stat-value">@d.Sent</span>
            <span class="stat-sub">@d.SentThisMonth هذا الشهر</span>
        </div>
        <div class="stat-card is-static">
            <span class="stat-icon is-warning"><svg class="ico"><use href="#i-clock" /></svg></span>
            <span class="stat-label">بانتظار الاعتماد</span>
            <span class="stat-value">@d.Pending</span>
            @if (d.LateCount > 0)
            {
                <span class="stat-sub is-alert">@d.LateCount متأخرة</span>
            }
        </div>
        <div class="stat-card is-static">
            <span class="stat-icon is-success"><svg class="ico"><use href="#i-check" /></svg></span>
            <span class="stat-label">التقارير المعتمدة</span>
            <span class="stat-value">@d.Approved</span>
            @if (d.AvgApprovalDays != null)
            {
                <span class="stat-sub">متوسط الاعتماد @d.AvgApprovalDays يوم</span>
            }
        </div>
        <div class="stat-card is-static">
            <span class="stat-icon is-danger"><svg class="ico"><use href="#i-return" /></svg></span>
            <span class="stat-label">المعادة للتعديل</span>
            <span class="stat-value">@d.Returned</span>
        </div>
    </div>

    <!-- الرسوم -->
    <div class="panel-grid panel-grid--wide">
        <section class="panel">
            <div class="panel-head">
                <h2>حركة التقارير</h2>
                <span class="chart-legend">
                    <span><i class="lg-1"></i>مرسلة</span>
                    <span><i class="lg-2"></i>معتمدة</span>
                </span>
            </div>
            <div class="bar-chart" role="img" aria-label="التقارير المرسلة والمعتمدة في آخر 6 أشهر">
                @foreach (var m in d.Months)
                {
                    <div class="bar-col">
                        <div class="bar-pair">
                            <span class="bar bar-1" style="height:@(m.First * 100 / chartMax)%" title="مرسلة: @m.First"><b>@m.First</b></span>
                            <span class="bar bar-2" style="height:@(m.Second * 100 / chartMax)%" title="معتمدة: @m.Second"><b>@m.Second</b></span>
                        </div>
                        <span class="bar-label">@m.Label</span>
                    </div>
                }
            </div>
        </section>

        <section class="panel">
            <div class="panel-head"><h2>حسب نوع التقرير</h2></div>
            @if (!d.ByType.Any())
            {
                <p class="panel-empty">لا توجد تقارير مرسلة</p>
            }
            @foreach (var t in d.ByType)
            {
                <div class="hbar">
                    <div class="hbar-row"><span>@AuditLabels.ReportType(t.Type)</span><b>@t.Count</b></div>
                    <div class="hbar-track"><span style="width:@(t.Count * 100 / typeMax)%"></span></div>
                </div>
            }
        </section>
    </div>

    <div class="panel-grid">
        <section class="panel">
            <div class="panel-head">
                <h2>جاهزية التوقيع</h2>
                <span class="panel-meta">@ready من @d.SigningUsers</span>
            </div>
            <ul class="list-rows">
                <li>
                    <span class="list-main">ختم الجهة</span>
                    @if (d.HasActiveStamp)
                    {
                        <span class="badge approved">مفعّل</span>
                    }
                    else
                    {
                        <span class="badge returned">غير موجود</span>
                        <a class="dga-link" asp-controller="Signatures" asp-action="Index">إضافة</a>
                    }
                </li>
                @foreach (var u in d.MissingSignatures)
                {
                    <li>
                        <span class="list-main">
                            <a class="dga-link" asp-controller="Users" asp-action="Details" asp-route-id="@u.UserId">@u.FullName</a>
                            <small>@u.RoleName</small>
                        </span>
                        <span class="badge warning">بدون توقيع</span>
                        <a class="dga-link" asp-controller="Signatures" asp-action="Index">إضافة</a>
                    </li>
                }
                @if (d.HasActiveStamp && !d.MissingSignatures.Any())
                {
                    <li><span class="list-main text-muted">كل المستخدمين لديهم توقيع</span></li>
                }
            </ul>
        </section>

        <section class="panel">
            <div class="panel-head">
                <h2>تقارير متأخرة في الاعتماد</h2>
                <span class="panel-meta">أكثر من 5 أيام</span>
            </div>
            <ul class="list-rows">
                @foreach (var r in d.Late)
                {
                    <li>
                        <span class="list-main">
                            <a class="dga-link" asp-controller="Reports" asp-action="Details" asp-route-id="@r.ReportId"><bdi>@r.ReportNumber</bdi></a>
                            <small>@AuditLabels.ReportType(r.ReportType) · @Responsible(r.ReportType)</small>
                        </span>
                        <span class="badge returned">@DaysText(r.Days)</span>
                    </li>
                }
                @if (!d.Late.Any())
                {
                    <li><span class="list-main text-muted">لا توجد تقارير متأخرة</span></li>
                }
            </ul>
        </section>
    </div>

</div>
