@using Land_plans_Report.Data
@using Land_plans_Report.Helpers
@using Land_plans_Report.Models
@model List<Report>
@{
    // عرض فقط: كل الأرقام تجي من DashboardController (ViewBag.Approver)
    var d = ViewBag.Approver as ApproverDashboardData ?? new ApproverDashboardData();
    int chartMax = Math.Max(1, d.Months.Select(m => Math.Max(m.First, m.Second)).DefaultIfEmpty(0).Max());

    string DaysText(int n) => n <= 0 ? "اليوم" : n == 1 ? "يوم واحد" : n == 2 ? "يومان" : n <= 10 ? $"{n} أيام" : $"{n} يوماً";
    string DaysTone(int n) => n >= 5 ? "returned" : n >= 3 ? "warning" : "draft";
}

<div class="dash">

    <div class="page-head">
        <h1 class="dash-title">لوحة التحكم</h1>
        <span class="page-meta">@DateDisplay.Date(DateTime.Today)</span>
    </div>

    @if (!d.HasSignature || !d.HasActiveStamp)
    {
        <div class="dga-alert dga-alert--warning" role="alert">
            <div>
                <p>
                    @(!d.HasSignature && !d.HasActiveStamp ? "لا يوجد توقيع مفعّل لك ولا ختم للجهة"
                        : !d.HasSignature ? "لا يوجد توقيع مفعّل لك"
                        : "لا يوجد ختم مفعّل للجهة") — تواصل مع مدير النظام قبل الاعتماد.
                </p>
            </div>
        </div>
    }

    <!-- المؤشرات -->
    <div class="stat-grid">
        <div class="stat-card is-static">
            <span class="stat-icon is-warning"><svg class="ico"><use href="#i-clock" /></svg></span>
            <span class="stat-label">بانتظار قرارك</span>
            <span class="stat-value">@d.Pending</span>
        </div>
        <div class="stat-card is-static">
            <span class="stat-icon is-success"><svg class="ico"><use href="#i-check" /></svg></span>
            <span class="stat-label">اعتمدتها هذا الشهر</span>
            <span class="stat-value">@d.ApprovedThisMonth</span>
        </div>
        <div class="stat-card is-static">
            <span class="stat-icon is-danger"><svg class="ico"><use href="#i-return" /></svg></span>
            <span class="stat-label">أعدتها هذا الشهر</span>
            <span class="stat-value">@d.ReturnedThisMonth</span>
        </div>
        <div class="stat-card is-static">
            <span class="stat-icon is-info"><svg class="ico"><use href="#i-pen" /></svg></span>
            <span class="stat-label">متوسط مدة القرار</span>
            <span class="stat-value">@(d.AvgDecisionDays == null ? "—" : $"{d.AvgDecisionDays} يوم")</span>
        </div>
    </div>

    <div class="panel-grid panel-grid--wide">
        <section class="panel">
            <div class="panel-head">
                <h2>بانتظار قرارك</h2>
                @if (d.Pending > 0)
                {
                    <a class="dga-link" asp-controller="Approval" asp-action="Index">عرض الكل</a>
                }
            </div>
            <ul class="list-rows">
                @foreach (var r in d.Waiting)
                {
                    <li>
                        <span class="list-main">
                            <a class="dga-link" asp-controller="Approval" asp-action="Review" asp-route-id="@r.ReportId"><bdi>@r.ReportNumber</bdi></a>
                            <small>@AuditLabels.ReportType(r.ReportType) · @r.Preparer</small>
                        </span>
                        <span class="badge @DaysTone(r.Days)">@DaysText(r.Days)</span>
                    </li>
                }
                @if (!d.Waiting.Any())
                {
                    <li><span class="list-main text-muted">لا توجد تقارير بانتظارك</span></li>
                }
            </ul>
        </section>

        <section class="panel">
            <div class="panel-head">
                <h2>قراراتي</h2>
                <span class="chart-legend">
                    <span><i class="lg-ok"></i>اعتماد</span>
                    <span><i class="lg-ret"></i>إعادة</span>
                </span>
            </div>
            <div class="bar-chart bar-chart--compact" role="img" aria-label="قراراتي في آخر 6 أشهر">
                @foreach (var m in d.Months)
                {
                    <div class="bar-col">
                        <div class="bar-pair">
                            <span class="bar bar-ok" style="height:@(m.First * 100 / chartMax)%" title="اعتماد: @m.First"><b>@m.First</b></span>
                            <span class="bar bar-ret" style="height:@(m.Second * 100 / chartMax)%" title="إعادة: @m.Second"><b>@m.Second</b></span>
                        </div>
                        <span class="bar-label">@m.Label</span>
                    </div>
                }
            </div>
        </section>
    </div>

</div>
