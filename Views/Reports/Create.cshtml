@using Land_plans_Report.Models
@using Land_plans_Report.Data
@model ReportFormViewModel
@{
    ViewData["Title"] = "إنشاء تقرير";
    ViewBag.ActivePage = "create";
    string type = Model?.ReportType ?? "plan";

    var titles = new Dictionary<string, string> {
        { "plan", "تقرير الحالة الفنية للمخطط (المنح المستلمة)" },
        { "plot", "تقرير الحالة الفنية لقطعة الأرض" },
        { "raw", "تقرير الحالة الفنية لأرض خام" },
        { "unplanned", "تقرير الحالة الفنية لأرض لا يوجد فيها مخطط" },
    };

    // عرض فقط: إذا فُتحت الصفحة بدون نوع (من القائمة الجانبية) نعرض اختيار النوع أولاً.
    // عند الرجوع من السيرفر بأخطاء (POST) يُعرض الفورم دائماً حتى لا تضيع البيانات.
    bool chooseType = HttpMethods.IsGet(Context.Request.Method)
                      && string.IsNullOrEmpty(Context.Request.Query["type"]);

    ViewData["CancelUrl"] = Url.Action("Index", "Dashboard");
}

<div class="dash report-wizard">

    @if (chooseType)
    {
        <nav class="breadcrumb" aria-label="مسار التصفح">
            <a asp-controller="Dashboard" asp-action="Index">لوحة التحكم</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">إنشاء تقرير</span>
        </nav>

        <div>
            <h1 class="dash-title">إنشاء تقرير جديد</h1>
            <p class="page-lead">اختر نوع التقرير للبدء</p>
        </div>

        <div class="type-grid">
            <a class="type-card" asp-action="Create" asp-route-type="plan">
                <span class="type-card-icon" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M9 21V9" /></svg></span>
                <strong>تقرير مخطط</strong>
                <span>الحالة الفنية للمخطط والخدمات (المنح المستلمة)</span>
                <span class="type-card-cta">ابدأ <svg class="ico ico-sm" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" /></svg></span>
            </a>
            <a class="type-card" asp-action="Create" asp-route-type="plot">
                <span class="type-card-icon" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg></span>
                <strong>تقرير قطعة أرض</strong>
                <span>بيانات المستفيد والقطعة وحالتها الفنية</span>
                <span class="type-card-cta">ابدأ <svg class="ico ico-sm" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" /></svg></span>
            </a>
            <a class="type-card" asp-action="Create" asp-route-type="raw">
                <span class="type-card-icon" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24"><path d="m3 20 6-10 4 6 3-4 5 8z" /><circle cx="17" cy="6" r="2" /></svg></span>
                <strong>تقرير أرض خام</strong>
                <span>الأرض الخام ونتائج المعاينة الميدانية</span>
                <span class="type-card-cta">ابدأ <svg class="ico ico-sm" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" /></svg></span>
            </a>
            <a class="type-card" asp-action="Create" asp-route-type="unplanned">
                <span class="type-card-icon" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24"><path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3z" /><path d="M9 3v15M15 6v15" /></svg></span>
                <strong>تقرير أرض بلا مخطط</strong>
                <span>موقع غير مخطط وحالته الفنية</span>
                <span class="type-card-cta">ابدأ <svg class="ico ico-sm" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" /></svg></span>
            </a>
        </div>
    }
    else
    {
        <nav class="breadcrumb" aria-label="مسار التصفح">
            <a asp-controller="Dashboard" asp-action="Index">لوحة التحكم</a>
            <span aria-hidden="true">/</span>
            <a asp-action="Create">إنشاء تقرير</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">@titles[type]</span>
        </nav>

        <h1 class="dash-title">@titles[type]</h1>

        @* ===================== مؤشر الخطوات ===================== *@
        <partial name="ReportForms/_WizardStepper" />

        <form method="post" asp-action="Create" enctype="multipart/form-data" novalidate data-wizard-form>
            <input type="hidden" name="ReportType" value="@type" />
            <div asp-validation-summary="All" class="form-summary"></div>

            @if (type == "plan")
            {
                <partial name="ReportForms/_PlanReportForm" />
            }
            else if (type == "plot")
            {
                <partial name="ReportForms/_PlotReportForm" />
            }
            else if (type == "raw")
            {
                <partial name="ReportForms/_RawLandReportForm" />
            }
            else
            {
                <partial name="ReportForms/_UnplannedLandReportForm" />
            }

            <partial name="ReportForms/_WizardNav" />
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/report-wizard.js" asp-append-version="true"></script>
}
