@using Land_plans_Report.Data
@model Report
@{
    Layout = null; // صفحة طباعة مستقلة، بدون القائمة الجانبية أو الهيدر
    var titles = new Dictionary<string, string> {
        { "plan", "تقرير الحالة الفنية للمخطط" },
        { "plot", "تقرير الحالة الفنية لقطعة الأرض" },
        { "raw", "تقرير الحالة الفنية لأرض خام" },
        { "unplanned", "تقرير الحالة الفنية لأرض لا يوجد فيها مخطط" },
    };
    var approval = Model.Approvals.OrderByDescending(a => a.DecisionDate).FirstOrDefault(a => a.Decision == "approve");
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@Model.ReportNumber</title>
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap');

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Cairo', sans-serif;
            direction: rtl;
            margin: 24px;
            color: #1e2b26;
            font-size: 13.5px;
        }

        .print-btn {
            position: fixed;
            top: 16px;
            left: 16px;
            padding: 10px 18px;
            background: #1a5f4a;
            color: #fff;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-family: inherit;
            font-size: 13px;
        }

        @@media print {
            .print-btn {
                display: none;
            }

            body {
                margin: 0;
            }
        }

        .doc-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #1a5f4a;
            padding-bottom: 12px;
            margin-bottom: 4px;
        }

            .doc-header .meta-box {
                border: 1px solid #999;
                font-size: 11px;
                padding: 4px 10px;
            }

                .doc-header .meta-box div {
                    padding: 2px 0;
                    border-bottom: 1px dotted #ccc;
                }

            .doc-header .brand {
                text-align: left;
            }

                .doc-header .brand strong {
                    display: block;
                    font-size: 14px;
                    color: #1a5f4a;
                }

        .doc-title {
            text-align: center;
            font-size: 16px;
            font-weight: 800;
            background: #eef3f0;
            padding: 8px;
            margin: 10px 0 16px;
            border-radius: 4px;
        }

        table.doc-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 14px;
        }

            table.doc-table th {
                background: #2d7a5f;
                color: #fff;
                padding: 8px;
                font-size: 12px;
                border: 1px solid #1a5f4a;
                width: 33.33%;
            }

            table.doc-table td {
                padding: 8px;
                border: 1px solid #cfd8d4;
                text-align: center;
                font-size: 13px;
                background: #fafcfb;
            }

        .section-title {
            background: #2d7a5f;
            color: #fff;
            padding: 6px 12px;
            font-size: 12.5px;
            font-weight: 700;
            border-radius: 4px 4px 0 0;
        }

        .section-body {
            border: 1px solid #cfd8d4;
            border-top: none;
            padding: 10px 14px;
            margin-bottom: 14px;
            border-radius: 0 0 4px 4px;
            min-height: 30px;
        }

        .photos-row {
            display: flex;
            gap: 8px;
            margin-bottom: 14px;
        }

            .photos-row img {
                width: 33%;
                height: 130px;
                object-fit: cover;
                border: 1px solid #cfd8d4;
                border-radius: 4px;
            }

        .footer-row {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            border: 1px solid #1a5f4a;
            margin-top: 18px;
        }

            .footer-row > div {
                padding: 12px;
                border-inline-start: 1px solid #1a5f4a;
                text-align: center;
            }

                .footer-row > div:first-child {
                    border-inline-start: none;
                }

            .footer-row .label {
                background: #2d7a5f;
                color: #fff;
                font-size: 11.5px;
                padding: 6px;
                margin: -12px -12px 10px;
            }

        .stamp-placeholder {
            width: 90px;
            height: 90px;
            margin: 6px auto;
            border: 2px dashed #2d7a5f;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            color: #2d7a5f;
            text-align: center;
        }
    </style>
</head>
<body>
    <button class="print-btn" onclick="window.print()">🖨️ طباعة / حفظ كـ PDF</button>

    <div class="doc-header">
        <div class="meta-box">
            <div>الرقم: @Model.ReportNumber</div>
            <div>التاريخ: @Model.CreatedAt.ToString("dd/MM/yyyy")</div>
            <div>المرفقات: @Model.Photos.Count</div>
        </div>
        <div class="brand">
            <strong>أمانة منطقة المدينة المنورة</strong>
            <span style="font-size:11px; color:#666;">وكالة شؤون الإسكان</span>
        </div>
    </div>

    <div class="doc-title">@titles[Model.ReportType]</div>

    @if (Model.PlanDetails != null)
    {
        var d = Model.PlanDetails;
        <table class="doc-table">
            <thead><tr><th>المساحة (م²)</th><th>اسم المخطط</th><th>كود المخطط</th></tr></thead>
            <tbody><tr><td>@d.Area</td><td>@d.PlanName</td><td>@d.PlanCode</td></tr></tbody>
        </table>
        <table class="doc-table">
            <thead><tr><th>المركز/القرية</th><th>المحافظة</th><th>المنطقة</th></tr></thead>
            <tbody><tr><td>@d.CenterOrVillage</td><td>@d.Governorate</td><td>@d.Region</td></tr></tbody>
        </table>
        <table class="doc-table">
            <thead><tr><th>عدد القطع</th><th>حالة الإسفلت</th><th>حالة الكهرباء</th></tr></thead>
            <tbody><tr><td>@d.PlotCount</td><td>@d.AsphaltStatus</td><td>@d.ElectricityStatus</td></tr></tbody>
        </table>
        <div class="section-title">الملاحظات والتوصيات</div>
        <div class="section-body">@d.UrbanCondition &nbsp; @Model.Notes</div>
    }
    else if (Model.PlotDetails != null)
    {
        var d = Model.PlotDetails;
        <table class="doc-table">
            <thead><tr><th>رقم الجوال</th><th>رقم الهوية الوطنية</th><th>اسم المستفيد</th></tr></thead>
            <tbody><tr><td>@d.BeneficiaryPhone</td><td>@d.BeneficiaryNationalId</td><td>@d.BeneficiaryName</td></tr></tbody>
        </table>
        <table class="doc-table">
            <thead><tr><th>اسم المخطط</th><th>المحافظة</th><th>المنطقة</th></tr></thead>
            <tbody><tr><td>@d.PlanName</td><td>@d.Governorate</td><td>@d.Region</td></tr></tbody>
        </table>
        <table class="doc-table">
            <thead><tr><th>رقم القطعة</th><th>—</th><th>كود المخطط</th></tr></thead>
            <tbody><tr><td>@d.PlotNumber</td><td>—</td><td>@d.PlanCode</td></tr></tbody>
        </table>
        <div class="section-title">الحالة الفنية للقطعة</div>
        <div class="section-body">@d.PlotCondition</div>
        <div class="section-title">التوصية</div>
        <div class="section-body">@d.Recommendation</div>
    }
    else if (Model.RawLandDetails != null)
    {
        var d = Model.RawLandDetails;
        <table class="doc-table">
            <thead><tr><th>المساحة (م²)</th><th>اسم المخطط</th><th>كود المخطط</th></tr></thead>
            <tbody><tr><td>@d.Area</td><td>@d.PlanName</td><td>@d.PlanCode</td></tr></tbody>
        </table>
        <table class="doc-table">
            <thead><tr><th>المركز/القرية</th><th>المحافظة</th><th>المنطقة</th></tr></thead>
            <tbody><tr><td>@d.CenterOrVillage</td><td>@d.Governorate</td><td>@d.Region</td></tr></tbody>
        </table>
        <div class="section-title">الحالة الفنية والمعاينة</div>
        <div class="section-body">حالة الإسفلت: @d.AsphaltStatus — الكهرباء: @d.ElectricityStatus — العمران: @d.UrbanCondition</div>
    }
    else if (Model.UnplannedLandDetails != null)
    {
        var d = Model.UnplannedLandDetails;
        <table class="doc-table">
            <thead><tr><th>المساحة (م²)</th><th>اسم المخطط الوصفي</th><th>كود المخطط الوصفي</th></tr></thead>
            <tbody><tr><td>@d.Area</td><td>@d.PlanName</td><td>@d.PlanCode</td></tr></tbody>
        </table>
        <table class="doc-table">
            <thead><tr><th>المركز/القرية</th><th>المحافظة</th><th>المنطقة</th></tr></thead>
            <tbody><tr><td>@d.CenterOrVillage</td><td>@d.Governorate</td><td>@d.Region</td></tr></tbody>
        </table>
        <div class="section-title">الحالة الفنية والمعاينة</div>
        <div class="section-body">داخل حد التنمية: @(d.InsideDevelopmentBoundary == true ? "نعم" : "لا") — الإسفلت: @d.AsphaltStatus — الكهرباء: @d.ElectricityStatus</div>
    }

    @if (Model.Photos.Any())
    {
        <div class="section-title">صور الموقع</div>
        <div class="photos-row" style="border:1px solid #cfd8d4; border-top:none; padding:10px;">
            @foreach (var p in Model.Photos.Take(3))
            {
                <img src="@p.FilePath" />
            }
        </div>
    }

    <div class="footer-row">
        <div>
            <div class="label">اعتماد @(Model.ReportType == "plan" ? "مدير عام شؤون الإسكان" : "مساعد وكيل شؤون الإسكان")</div>
            <div>الاسم: @(approval != null ? "معتمد" : "—")</div>
            <div>التاريخ: @(approval?.DecisionDate.ToString("dd/MM/yyyy") ?? "—")</div>
        </div>
        <div>
            <div class="label">الختم</div>
            <div class="stamp-placeholder">أمانة منطقة<br />المدينة المنورة</div>
        </div>
        <div>
            <div class="label">معد التقرير</div>
            <div>الاسم: —</div>
            <div>التاريخ: @Model.CreatedAt.ToString("dd/MM/yyyy")</div>
        </div>
    </div>
</body>
</html>
