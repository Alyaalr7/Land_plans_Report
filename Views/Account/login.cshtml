@{
    Layout = null;
    ViewData["Title"] = "تسجيل الدخول";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>تسجيل الدخول - نظام تقارير المخططات وقطع الأراضي</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .login-shell {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--primary-dark);
        }

        .login-card {
            width: 380px;
            background: #fff;
            border-radius: var(--radius);
            box-shadow: var(--shadow-md);
            padding: 32px 28px;
        }

        .login-logo {
            width: 52px;
            height: 52px;
            background: var(--primary);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 800;
            font-size: 22px;
            margin: 0 auto 14px;
        }

        .login-title {
            text-align: center;
            margin-bottom: 4px;
            font-size: 16px;
            font-weight: 800;
            color: var(--primary-dark);
        }

        .login-subtitle {
            text-align: center;
            margin-bottom: 24px;
            font-size: 12.5px;
            color: var(--text-muted);
        }

        .login-error {
            background: var(--status-returned-bg);
            color: var(--status-returned-text);
            padding: 10px 14px;
            border-radius: var(--radius-sm);
            font-size: 12.5px;
            margin-bottom: 16px;
        }

        .login-note {
            margin-top: 18px;
            padding: 10px 12px;
            background: #fdf1dd;
            color: #a97c1f;
            border-radius: var(--radius-sm);
            font-size: 11.5px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="login-shell">
        <div class="login-card">
            <div class="login-logo">م</div>
            <div class="login-title">أمانة منطقة المدينة المنورة</div>
            <div class="login-subtitle">نظام تقارير المخططات وقطع الأراضي</div>

            @if (ViewBag.Error != null)
            {
                <div class="login-error">@ViewBag.Error</div>
            }

            <form method="post" asp-action="Login">
                <div class="field mb-16">
                    <label>اسم المستخدم</label>
                    <input type="text" name="username" placeholder="أدخل اسم المستخدم" />
                </div>
                <div class="field mb-16">
                    <label>كلمة المرور</label>
                    <input type="password" name="password" placeholder="أدخل كلمة المرور" />
                </div>
                <button type="submit" class="btn btn-primary" style="width:100%;">تسجيل الدخول</button>
            </form>

            <div class="login-note">
                تسجيل دخول تجريبي مؤقت  إ.
            </div>
        </div>
    </div>
</body>
</html>
