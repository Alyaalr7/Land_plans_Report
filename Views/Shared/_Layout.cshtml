@{
    // الرول يُقرأ من الجلسة مباشرة — إذا غير معروف ما تظهر أي قوائم إدارية
    string currentRole = Context.Session.GetString("RoleCode") switch
    {
        "Admin" => "Admin",
        "Technical" => "Technical",
        "PlotApprover" or "PlanApprover" => "Approver",
        _ => ""
    };
    string activePage = ViewBag.ActivePage ?? "";

    // عرض فقط: نفس النصوص السابقة، مرتبة في متغيرات
    string roleLabel = currentRole == "Admin" ? "مدير النظام" : currentRole == "Approver" ? "معتمد" : "منسوب الشؤون الفنية";
    string displayName = Context.Session.GetString("FullName") ?? roleLabel;
    string avatarLetter = string.IsNullOrWhiteSpace(displayName) ? "م" : displayName.Trim().Substring(0, 1);
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - نظام تقارير المخططات وقطع الأراضي</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
</head>
<body>
    <!-- أيقونات (تُعرّف مرة وحدة وتُستخدم بـ use) -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <defs>
            <symbol id="i-grid" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></symbol>
            <symbol id="i-file" viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></symbol>
            <symbol id="i-file-plus" viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M12 11v6M9 14h6" /></symbol>
            <symbol id="i-pen" viewBox="0 0 24 24"><path d="M4 20h4L19 9l-4-4L4 16z" /><path d="M13 7l4 4" /></symbol>
            <symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5" /><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6" /><path d="M16 4.5a3.5 3.5 0 0 1 0 7M21 20c0-2.6-1.6-4.8-4-5.6" /></symbol>
            <symbol id="i-building" viewBox="0 0 24 24"><path d="M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16M16 9h2a2 2 0 0 1 2 2v10M2 21h20M8 7h4M8 11h4M8 15h4" /></symbol>
            <symbol id="i-stamp" viewBox="0 0 24 24"><path d="M9 4h6v5l3 3v3H6v-3l3-3z" /><path d="M5 19h14" /></symbol>
            <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></symbol>
            <symbol id="i-bell" viewBox="0 0 24 24"><path d="M6 9a6 6 0 0 1 12 0c0 6 2.5 7.5 2.5 7.5h-17S6 15 6 9" /><path d="M10 20a2 2 0 0 0 4 0" /></symbol>
            <symbol id="i-help" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M9.5 9.5a2.5 2.5 0 0 1 4.6 1.3c0 1.7-2.1 2.2-2.1 3.7" /><circle cx="12" cy="17.2" r=".6" fill="currentColor" /></symbol>
            <symbol id="i-chevron" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></symbol>
            <symbol id="i-logout" viewBox="0 0 24 24"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3" /><path d="M10 8l-4 4 4 4M6 12h10" /></symbol>
            <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></symbol>
            <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></symbol>
            <symbol id="i-check" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="m8.5 12 2.5 2.5 4.5-5" /></symbol>
            <symbol id="i-return" viewBox="0 0 24 24"><path d="M9 14 4 9l5-5" /><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11" /></symbol>
            <symbol id="i-draft" viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h4" /><path d="M14 3v5h5v3" /><path d="M14.5 20.5 20 15l-2-2-5.5 5.5-.5 2.5z" /></symbol>
        </defs>
    </svg>


    <a class="skip-link" href="#main-content">تخطي إلى المحتوى</a>

    <div class="shell">

        <!-- شريط الموقع  -->
        <div class="gov-ribbon">
            <svg class="gov-flag" viewBox="0 0 30 20" aria-hidden="true"><rect width="30" height="20" rx="2" fill="#1b8354" /><path d="M8 13h14" stroke="#fff" stroke-width="1.4" stroke-linecap="round" /><path d="M9 8.5h12" stroke="#fff" stroke-width="1" stroke-linecap="round" opacity=".85" /></svg>
            <span>منصة حكومية رسمية تابعة لأمانة منطقة المدينة المنورة</span>
        </div>

        <!-- الشريط العلوي -->
        <header class="app-header">
            <a class="app-brand" asp-controller="Dashboard" asp-action="Index" aria-label="الرئيسية">
                <img src="~/Images/colored-logo (1).svg" alt="أمانة منطقة المدينة المنورة" class="app-logo" />
                <span class="app-brand-divider" aria-hidden="true"></span>
                <span class="app-brand-name">نظام تقارير المخططات وقطع الأراضي</span>
            </a>

            <div class="app-header-actions">
                <a href="#" class="icon-btn" title="الإشعارات" aria-label="الإشعارات">
                    <svg class="ico"><use href="#i-bell" /></svg>
                </a>
                <a href="#" class="icon-btn" title="المساعدة" aria-label="المساعدة">
                    <svg class="ico"><use href="#i-help" /></svg>
                </a>

                <details class="user-menu">
                    <summary aria-label="قائمة المستخدم">
                        <span class="user-avatar" aria-hidden="true">@avatarLetter</span>
                        <span class="user-name">@displayName</span>
                        <svg class="ico ico-sm"><use href="#i-chevron" /></svg>
                    </summary>
                    <div class="user-menu-panel">
                        <div class="user-menu-head">
                            <strong>@displayName</strong>
                            <span>@roleLabel</span>
                        </div>
                        <a class="user-menu-item" asp-controller="Account" asp-action="Logout">
                            <svg class="ico"><use href="#i-logout" /></svg>
                            تسجيل الخروج
                        </a>
                    </div>
                </details>
            </div>
        </header>

        <!-- القائمة الجانبية -->
        <nav class="side-nav" aria-label="القائمة الرئيسية">
            <div class="side-nav-title">القائمة الرئيسية</div>
            <ul>
                <li><a asp-controller="Dashboard" asp-action="Index" class="@(activePage == "dashboard" ? "active" : "")"><svg class="ico"><use href="#i-grid" /></svg> لوحة التحكم</a></li>
                <li><a asp-controller="Reports" asp-action="Index" class="@(activePage == "reports" ? "active" : "")"><svg class="ico"><use href="#i-file" /></svg> التقارير والمعاملات</a></li>

                @if (currentRole == "Technical")
                {
                    <li><a asp-controller="Reports" asp-action="Create" class="@(activePage == "create" ? "active" : "")"><svg class="ico"><use href="#i-file-plus" /></svg> إنشاء تقرير جديد</a></li>
                }

                @if (currentRole == "Approver")
                {
                    <li><a asp-controller="Approval" asp-action="Index" class="@(activePage == "approval" ? "active" : "")"><svg class="ico"><use href="#i-pen" /></svg> التوقيع والاعتماد</a></li>
                }
            </ul>

            @if (currentRole == "Admin")
            {
                <div class="side-nav-title">إدارة النظام</div>
                <ul>
                    <li><a asp-controller="Users" asp-action="Index" class="@(activePage == "users" ? "active" : "")"><svg class="ico"><use href="#i-users" /></svg> المستخدمون</a></li>
                    <li><a asp-controller="Signatures" asp-action="Index" class="@(activePage == "signatures" ? "active" : "")"><svg class="ico"><use href="#i-stamp" /></svg> التوقيعات والأختام</a></li>
                </ul>
            }

            @if (currentRole == "Admin" || currentRole == "Approver" || currentRole == "Technical")
            {
                <div class="side-nav-divider" aria-hidden="true"></div>
                <ul>
                    <li><a asp-controller="AuditLog" asp-action="Index" class="@(activePage == "audit" ? "active" : "")"><svg class="ico"><use href="#i-clock" /></svg> سجل التدقيق@(currentRole == "Admin" ? "" : " (عملياتي)")</a></li>
                </ul>
            }
        </nav>

        <!-- المحتوى -->
        <main class="main" id="main-content">
            @if (TempData["Success"] is string ok)
            {
                <dialog class="dga-dialog" data-success-dialog aria-labelledby="success-title">
                    <div class="dga-dialog-icon" aria-hidden="true">
                        <svg class="ico" viewBox="0 0 24 24"><path d="m5 12 5 5 9-10" /></svg>
                    </div>
                    <h2 id="success-title">@ok</h2>
                    <div class="dga-dialog-actions">
                        <button type="button" class="dga-btn dga-btn--primary" data-dialog-close>حسناً</button>
                    </div>
                </dialog>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
