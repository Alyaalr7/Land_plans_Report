@using Land_plans_Report.Data
@model List<Report>
@{
    ViewData["Title"] = "التقارير المعلقة";
    ViewBag.ActivePage = "approval";
}

<div class="page-header">
    <div>
        <div class="accent-bar"></div>
        <h1>التقارير بانتظار اعتمادك</h1>
        <p>هذي القائمة مفلترة تلقائياً حسب صلاحيتك — لا تظهر إلا الأنواع المخصصة لدورك</p>
    </div>
</div>

<div class="card">
    <div class="table-wrap">
        <table class="data-table">
            <thead><tr><th>رقم التقرير</th><th>النوع</th><th>تاريخ الإرسال</th><th>الإجراء</th></tr></thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="4" style="text-align:center; color:var(--text-muted);">لا توجد تقارير معلقة حالياً</td></tr>
                }
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.ReportNumber</td>
                        <td>@r.ReportType</td>
                        <td>@(r.SubmittedAt?.ToString("dd MMM yyyy") ?? "-")</td>
                        <td><a class="link-action" asp-action="Review" asp-route-id="@r.ReportId">مراجعة</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
