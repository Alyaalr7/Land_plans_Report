@using Land_plans_Report.Data
@using Land_plans_Report.Helpers
@model Report
@{
    ViewData["Title"] = "مراجعة التقرير";
    ViewBag.ActivePage = "approval";

    int? mySignatureId = ViewBag.MySignatureId as int?;
    int? stampId = ViewBag.StampId as int?;
    bool canApprove = mySignatureId != null && stampId != null;

    // عرض فقط: عنصر (عنوان + قيمة)، والقيمة الفاضية تظهر "—"
    void Field(string label, object? value, string? unit = null)
    {
        var text = value?.ToString();
        <div class="kv">
            <dt>@label</dt>
            <dd>@(string.IsNullOrWhiteSpace(text) ? "—" : (unit == null ? text : text + " " + unit))</dd>
        </div>
    }
}

<div class="dash">

    <nav class="breadcrumb" aria-label="مسار التصفح">
        <a asp-action="Index">التقارير بانتظار الاعتماد</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page"><bdi>@Model.ReportNumber</bdi></span>
    </nav>

    <div class="page-head">
        <div>
            <h1 class="dash-title">@ReportLabels.Title(Model.ReportType)</h1>
            <div class="page-meta">
                <bdi>@Model.ReportNumber</bdi>
                <partial name="_StatusBadgePartial" model="@Model.Status" />
            </div>
        </div>
        <div class="page-actions">
            <a asp-controller="Reports" asp-action="Print" asp-route-id="@Model.ReportId" target="_blank" class="dga-btn dga-btn--secondary">معاينة الطباعة</a>
        </div>
    </div>

    @if (TempData["ApprovalError"] is string error)
    {
        <div class="dga-alert dga-alert--danger" role="alert"><div><p>@error</p></div></div>
    }

    @if (!canApprove)
    {
        <div class="dga-alert dga-alert--warning" role="alert">
            <div>
                <p>
                    @(mySignatureId == null && stampId == null ? "لا يوجد توقيع مفعّل لك ولا ختم للجهة"
                        : mySignatureId == null ? "لا يوجد توقيع مفعّل لك"
                        : "لا يوجد ختم مفعّل للجهة") — يمكنك إعادة التقرير فقط، تواصل مع مدير النظام للاعتماد.
                </p>
            </div>
        </div>
    }

    <section class="detail-card">
        <h2>بيانات عامة</h2>
        <dl class="kv-grid">
            @{
                Field("معد التقرير", Model.CreatedByUser?.FullName);
            }
            @{
                Field("تاريخ الإرسال", Model.SubmittedAt == null ? null : DateDisplay.When(Model.SubmittedAt.Value));
            }
            @{
                Field("المرفقات", Model.Photos.Count);
            }
        </dl>
    </section>

    @if (Model.PlanDetails != null)
    {
        var d = Model.PlanDetails;
        <section class="detail-card">
            <h2>بيانات المخطط</h2>
            <dl class="kv-grid">
                @{
                    Field("كود المخطط", d.PlanCode);
                }
                @{
                    Field("اسم المخطط", d.PlanName);
                }
                @{
                    Field("المساحة", ReportLabels.Number(d.Area), "م²");
                }
                @{
                    Field("المنطقة", d.Region);
                }
                @{
                    Field("المحافظة", d.Governorate);
                }
                @{
                    Field("المركز أو القرية", d.CenterOrVillage);
                }
                @{
                    Field("عدد القطع", d.PlotCount);
                }
                @{
                    Field("البعد عن المركز", ReportLabels.Number(d.DistanceFromCenter), "كم");
                }
                @{
                    Field("حالة الإسفلت", ReportLabels.Option(d.AsphaltStatus));
                }
                @{
                    Field("شبكة المياه والصرف", ReportLabels.Option(d.WaterDrainage));
                }
                @{
                    Field("حالة الكهرباء", ReportLabels.Option(d.ElectricityStatus));
                }
                @{
                    Field("نسبة العمران", d.UrbanCondition, "%");
                }
            </dl>
        </section>
    }
    else if (Model.PlotDetails != null)
    {
        var d = Model.PlotDetails;
        <section class="detail-card">
            <h2>بيانات المستفيد والقطعة</h2>
            <dl class="kv-grid">
                @{
                    Field("اسم المستفيد", d.BeneficiaryName);
                }
                @{
                    Field("رقم الهوية", d.BeneficiaryNationalId);
                }
                @{
                    Field("رقم الجوال", d.BeneficiaryPhone);
                }
                @{
                    Field("المنطقة", d.Region);
                }
                @{
                    Field("المحافظة", d.Governorate);
                }
                @{
                    Field("اسم المخطط", d.PlanName);
                }
                @{
                    Field("كود المخطط", d.PlanCode);
                }
                @{
                    Field("رقم القطعة", d.PlotNumber);
                }
                @{
                    Field("الحالة الفنية", ReportLabels.Option(d.PlotCondition));
                }
                @{
                    Field("التوصية", ReportLabels.Option(d.Recommendation));
                }
            </dl>
            @if (!string.IsNullOrEmpty(d.IncompleteNotes))
            {
                <div class="detail-note"><dt>أوجه عدم الاكتمال</dt><dd>@d.IncompleteNotes</dd></div>
            }
            @if (!string.IsNullOrEmpty(d.NotSuitableNotes))
            {
                <div class="detail-note"><dt>أسباب عدم الصلاحية</dt><dd>@d.NotSuitableNotes</dd></div>
            }
        </section>
    }
    else if (Model.RawLandDetails != null)
    {
        var d = Model.RawLandDetails;
        <section class="detail-card">
            <h2>بيانات الأرض الخام</h2>
            <dl class="kv-grid">
                @{
                    Field("يوجد مخطط معتمد", ReportLabels.YesNo(d.HasApprovedPlan));
                }
                @{
                    Field("كود المخطط", d.PlanCode);
                }
                @{
                    Field("اسم المخطط", d.PlanName);
                }
                @{
                    Field("المساحة", ReportLabels.Number(d.Area), "م²");
                }
                @{
                    Field("المنطقة", d.Region);
                }
                @{
                    Field("المحافظة", d.Governorate);
                }
                @{
                    Field("المركز أو القرية", d.CenterOrVillage);
                }
                @{
                    Field("عدد القطع", d.PlotCount);
                }
                @{
                    Field("البعد عن المركز", ReportLabels.Number(d.DistanceFromCenter), "كم");
                }
                @{
                    Field("حالة الإسفلت", ReportLabels.Option(d.AsphaltStatus));
                }
                @{
                    Field("حالة الكهرباء", ReportLabels.Option(d.ElectricityStatus));
                }
                @{
                    Field("نسبة العمران", d.UrbanCondition, "%");
                }
            </dl>
        </section>
    }
    else if (Model.UnplannedLandDetails != null)
    {
        var d = Model.UnplannedLandDetails;
        <section class="detail-card">
            <h2>بيانات الأرض بلا مخطط</h2>
            <dl class="kv-grid">
                @{
                    Field("كود المخطط الوصفي", d.PlanCode);
                }
                @{
                    Field("اسم المخطط الوصفي", d.PlanName);
                }
                @{
                    Field("المساحة", ReportLabels.Number(d.Area), "م²");
                }
                @{
                    Field("المنطقة", d.Region);
                }
                @{
                    Field("المحافظة", d.Governorate);
                }
                @{
                    Field("المركز أو القرية", d.CenterOrVillage);
                }
                @{
                    Field("عدد القطع", d.PlotCount);
                }
                @{
                    Field("داخل حد التنمية", ReportLabels.YesNo(d.InsideDevelopmentBoundary));
                }
                @{
                    Field("البعد عن المركز", ReportLabels.Number(d.DistanceFromCenter), "كم");
                }
                @{
                    Field("حالة الإسفلت", ReportLabels.Option(d.AsphaltStatus));
                }
                @{
                    Field("حالة الكهرباء", ReportLabels.Option(d.ElectricityStatus));
                }
                @{
                    Field("نسبة العمران", d.UrbanCondition, "%");
                }
            </dl>
        </section>
    }

    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <section class="detail-card">
            <h2>الملاحظات</h2>
            <p class="detail-text">@Model.Notes</p>
        </section>
    }

    @if (Model.Photos.Any())
    {
        <section class="detail-card">
            <h2>المرفقات <span class="detail-count">(@Model.Photos.Count)</span></h2>
            <div class="photo-grid">
                @foreach (var photo in Model.Photos)
                {
                    var fileUrl = Url.Action("Photo", "Files", new { id = photo.PhotoId });
                    if (SecureFileStorage.IsPdf(photo.FilePath))
                    {
                        <a href="@fileUrl" target="_blank" rel="noopener" class="photo-item photo-item--file">
                            <svg class="ico" aria-hidden="true"><use href="#i-file" /></svg>
                            <span>ملف PDF</span>
                        </a>
                    }
                    else
                    {
                        <a href="@fileUrl" target="_blank" rel="noopener" class="photo-item">
                            <img src="@fileUrl" alt="صورة مرفقة بالتقرير" loading="lazy" />
                        </a>
                    }
                }
            </div>
        </section>
    }

    <!-- القرار -->
    <form method="post" asp-action="Submit" id="approvalForm" class="report-wizard">
        <input type="hidden" name="reportId" value="@Model.ReportId" />

        <section class="detail-card">
            <h2>القرار</h2>

            <div class="field">
                <label>القرار <span class="req">*</span></label>
                <div class="radio-group">
                    <label class="radio-option"><input type="radio" name="action" value="approve" required disabled="@(!canApprove)" /> اعتماد</label>
                    <label class="radio-option"><input type="radio" name="action" value="return" required checked="@(!canApprove)" /> إعادة للتعديل</label>
                </div>
            </div>

            <div class="field review-notes">
                <label for="approverNotes" id="notesLabel">الملاحظات</label>
                <textarea name="approverNotes" id="approverNotes" maxlength="500"></textarea>
                <span class="field-hint" id="notesHint">سبب الإعادة إلزامي</span>
            </div>

            <!-- معاينة التوقيع والختم كما ستظهر في التقرير -->
            <div class="review-sign" id="signPreview">
                <figure>
                    <figcaption>توقيعك</figcaption>
                    @if (mySignatureId != null)
                    {
                        <img src="@Url.Action("Signature", "Files", new { id = mySignatureId })" alt="توقيعك" />
                    }
                    else
                    {
                        <span class="review-sign-empty">غير موجود</span>
                    }
                </figure>
                <figure>
                    <figcaption>ختم الجهة</figcaption>
                    @if (stampId != null)
                    {
                        <img src="@Url.Action("Signature", "Files", new { id = stampId })" alt="ختم الجهة" />
                    }
                    else
                    {
                        <span class="review-sign-empty">غير موجود</span>
                    }
                </figure>
            </div>
        </section>

        <div class="review-actions">
            <a asp-action="Index" class="dga-btn dga-btn--secondary">إلغاء</a>
            <button type="button" class="dga-btn dga-btn--primary" id="confirmOpen">تأكيد القرار</button>
        </div>

        <dialog class="dga-dialog" id="confirmDialog" aria-labelledby="confirm-title">
            <div class="dga-dialog-icon" aria-hidden="true"><svg class="ico"><use href="#i-check" /></svg></div>
            <h2 id="confirm-title"></h2>
            <p>لا يمكن تعديل القرار بعد تأكيده.</p>
            <div class="dga-dialog-actions">
                <button type="button" class="dga-btn dga-btn--secondary" data-dialog-close>رجوع</button>
                <button type="submit" class="dga-btn dga-btn--primary">تأكيد</button>
            </div>
        </dialog>
    </form>

</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('approvalForm');
            var notes = document.getElementById('approverNotes');
            var label = document.getElementById('notesLabel');
            var hint = document.getElementById('notesHint');
            var preview = document.getElementById('signPreview');
            var dialog = document.getElementById('confirmDialog');

            // الملاحظات إلزامية مع الإعادة، اختيارية مع الاعتماد — والتوقيع يظهر مع الاعتماد فقط
            function sync() {
                var chosen = form.querySelector('input[name="action"]:checked');
                var isReturn = chosen && chosen.value === 'return';
                notes.required = isReturn;
                label.innerHTML = isReturn ? 'سبب الإعادة <span class="req">*</span>' : 'الملاحظات';
                hint.hidden = !isReturn;
                preview.hidden = !chosen || isReturn;
            }
            form.querySelectorAll('input[name="action"]').forEach(function (r) { r.addEventListener('change', sync); });
            sync();

            // التحقق ثم نافذة التأكيد
            document.getElementById('confirmOpen').addEventListener('click', function () {
                if (!notes.value.trim()) notes.value = '';
                if (!form.reportValidity()) return;
                var isReturn = form.querySelector('input[name="action"]:checked').value === 'return';
                document.getElementById('confirm-title').textContent = isReturn ? 'إعادة التقرير للتعديل؟' : 'اعتماد التقرير؟';
                dialog.showModal();
            });
        })();
    </script>
}
