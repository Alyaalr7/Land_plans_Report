@using Land_plans_Report.Data
@model Report
@{
    ViewData["Title"] = "مراجعة التقرير";
    ViewBag.ActivePage = "approval";
}

<div class="page-header">
    <div>
        <div class="accent-bar"></div>
        <h1>مراجعة التقرير @Model.ReportNumber</h1>
        <p>مراجعة البيانات واتخاذ قرار الاعتماد أو الإعادة — لن يمكن التعديل على هذا القرار بعد إرساله</p>
    </div>
    <a asp-controller="Reports" asp-action="Details" asp-route-id="@Model.ReportId" class="btn btn-outline">عرض التفاصيل كاملة</a>
</div>

@if (TempData["ApprovalError"] != null)
{
    <div style="background:var(--status-returned-bg); color:var(--status-returned-text); padding:12px 16px; border-radius:var(--radius-sm); margin-bottom:16px; font-size:13.5px;">
        ⚠ @TempData["ApprovalError"]
    </div>
}

<div class="form-section">
    <div class="form-section-header">
        <div class="step-number">1</div>
        <div><h4>ملخص المعاملة</h4></div>
    </div>
    <div class="form-section-body">
        <div class="form-grid cols-2">
            <div class="field"><label>نوع التقرير</label><input type="text" value="@Model.ReportType" readonly /></div>
            <div class="field"><label>تاريخ الإرسال</label><input type="text" value="@(Model.SubmittedAt?.ToString("dd MMM yyyy") ?? "-")" readonly /></div>
            <div class="field"><label>الحالة الحالية</label><div style="padding-top:8px;"><partial name="_StatusBadgePartial" model="@Model.Status" /></div></div>
        </div>
    </div>
</div>

@if (Model.PlotDetails != null)
{
    <div class="form-section">
        <div class="form-section-header"><div class="step-number">2</div><div><h4>بيانات المستفيد والقطعة</h4></div></div>
        <div class="form-section-body">
            <div class="form-grid cols-2">
                <div class="field"><label>المستفيد</label><input type="text" value="@Model.PlotDetails.BeneficiaryName" readonly /></div>
                <div class="field"><label>رقم الهوية</label><input type="text" value="@Model.PlotDetails.BeneficiaryNationalId" readonly /></div>
                <div class="field"><label>المخطط</label><input type="text" value="@Model.PlotDetails.PlanCode" readonly /></div>
                <div class="field"><label>رقم القطعة</label><input type="text" value="@Model.PlotDetails.PlotNumber" readonly /></div>
                <div class="field"><label>الحالة الفنية</label><input type="text" value="@Model.PlotDetails.PlotCondition" readonly /></div>
                <div class="field"><label>التوصية</label><input type="text" value="@Model.PlotDetails.Recommendation" readonly /></div>
            </div>
        </div>
    </div>
}
else if (Model.PlanDetails != null)
{
    <div class="form-section">
        <div class="form-section-header"><div class="step-number">2</div><div><h4>بيانات المخطط</h4></div></div>
        <div class="form-section-body">
            <div class="form-grid cols-2">
                <div class="field"><label>كود المخطط</label><input type="text" value="@Model.PlanDetails.PlanCode" readonly /></div>
                <div class="field"><label>اسم المخطط</label><input type="text" value="@Model.PlanDetails.PlanName" readonly /></div>
                <div class="field"><label>المساحة</label><input type="text" value="@(Model.PlanDetails.Area) م²" readonly /></div>
                <div class="field"><label>عدد القطع</label><input type="text" value="@Model.PlanDetails.PlotCount" readonly /></div>
            </div>
        </div>
    </div>
}
else if (Model.RawLandDetails != null)
{
    <div class="form-section">
        <div class="form-section-header"><div class="step-number">2</div><div><h4>بيانات الأرض الخام</h4></div></div>
        <div class="form-section-body">
            <div class="form-grid cols-2">
                <div class="field"><label>هل يوجد مخطط معتمد</label><input type="text" value="@(Model.RawLandDetails.HasApprovedPlan == true ? "نعم" : "لا")" readonly /></div>
                <div class="field"><label>المساحة</label><input type="text" value="@(Model.RawLandDetails.Area) م²" readonly /></div>
                <div class="field"><label>حالة الإسفلت</label><input type="text" value="@Model.RawLandDetails.AsphaltStatus" readonly /></div>
                <div class="field"><label>حالة الكهرباء</label><input type="text" value="@Model.RawLandDetails.ElectricityStatus" readonly /></div>
            </div>
        </div>
    </div>
}
else if (Model.UnplannedLandDetails != null)
{
    <div class="form-section">
        <div class="form-section-header"><div class="step-number">2</div><div><h4>بيانات الأرض بلا مخطط</h4></div></div>
        <div class="form-section-body">
            <div class="form-grid cols-2">
                <div class="field"><label>داخل حد التنمية</label><input type="text" value="@(Model.UnplannedLandDetails.InsideDevelopmentBoundary == true ? "نعم" : "لا")" readonly /></div>
                <div class="field"><label>المساحة</label><input type="text" value="@(Model.UnplannedLandDetails.Area) م²" readonly /></div>
                <div class="field"><label>حالة الإسفلت</label><input type="text" value="@Model.UnplannedLandDetails.AsphaltStatus" readonly /></div>
                <div class="field"><label>حالة الكهرباء</label><input type="text" value="@Model.UnplannedLandDetails.ElectricityStatus" readonly /></div>
            </div>
        </div>
    </div>
}

<div class="audit-strip mb-16">📎 المرفقات: @Model.Photos.Count صورة</div>

<form method="post" asp-action="Submit" id="approvalForm">
    <input type="hidden" name="reportId" value="@Model.ReportId" />
    <div class="form-section">
        <div class="form-section-header"><div class="step-number">3</div><div><h4>قرار الاعتماد</h4></div></div>
        <div class="form-section-body">
            <div class="form-grid cols-2" style="margin-bottom:18px;">
                <div class="field">
                    <label>القرار <span class="req">*</span></label>
                    <div class="radio-group">
                        <label class="radio-option"><input type="radio" name="action" value="approve" required /> موافقة</label>
                        <label class="radio-option"><input type="radio" name="action" value="return" required /> إعادة للتعديل</label>
                    </div>
                </div>
                <div class="field">
                    <label id="notesLabel">ملاحظات (اختيارية)</label>
                    <input type="text" name="approverNotes" id="approverNotes" placeholder="اختياري مع الموافقة، إلزامي مع الإعادة" />
                </div>
            </div>
            <partial name="_SignatureStampPartial" />
        </div>
    </div>
    <div class="form-footer-bar">
        <button type="button" class="btn btn-ghost" onclick="history.back()">إلغاء</button>
        <button type="submit" class="btn btn-primary">تأكيد القرار</button>
    </div>
</form>

@section Scripts {
    <script>
        // ⚠️ إصلاح: الملاحظات تصبح إلزامية بالواجهة فوراً عند اختيار "إعادة للتعديل"، اختيارية عند "موافقة"
        (function () {
            var radios = document.querySelectorAll('input[name="action"]');
            var notesInput = document.getElementById('approverNotes');
            var notesLabel = document.getElementById('notesLabel');

            radios.forEach(function (r) {
                r.addEventListener('change', function () {
                    if (r.value === 'return' && r.checked) {
                        notesInput.required = true;
                        notesLabel.innerHTML = 'ملاحظات <span class="req">*</span> (إلزامي)';
                    } else if (r.value === 'approve' && r.checked) {
                        notesInput.required = false;
                        notesLabel.innerText = 'ملاحظات (اختيارية)';
                    }
                });
            });

            document.getElementById('approvalForm').addEventListener('submit', function (e) {
                var returnSelected = document.querySelector('input[name="action"][value="return"]').checked;
                if (returnSelected && !notesInput.value.trim()) {
                    e.preventDefault();
                    alert('توضيح سبب الإعادة إلزامي عند اختيار "إعادة للتعديل".');
                }
            });
        })();
    </script>
}
