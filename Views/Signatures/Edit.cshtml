@using Land_plans_Report.Data
@model Role
@{
    ViewData["Title"] = "تعديل نص الختم";
    ViewBag.ActivePage = "signatures";
}

<div class="page-header">
    <div>
        <div class="accent-bar"></div>
        <h1>تعديل ختم: @Model.RoleName</h1>
    </div>
</div>

<form method="post" asp-action="Edit">
    <input type="hidden" name="roleId" value="@Model.RoleId" />
    <div class="form-section">
        <div class="form-section-body">
            <div class="field">
                <label>نص الختم الرسمي <span class="req">*</span></label>
                <textarea name="stampText" rows="3">@Model.StampText</textarea>
            </div>
        </div>
    </div>
    <div class="form-footer-bar">
        <a asp-action="Index" class="btn btn-ghost">إلغاء</a>
        <button type="submit" class="btn btn-primary">حفظ</button>
    </div>
</form>
