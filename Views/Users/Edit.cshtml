@using Land_plans_Report.Data
@model User
@{
    ViewData["Title"] = "تعديل مستخدم";
    ViewBag.ActivePage = "users";
    var roles = ViewBag.Roles as List<Role> ?? new();
    bool isSelf = Context.Session.GetInt32("UserId") == Model.UserId;
}

<div class="dash report-wizard">

    <nav class="breadcrumb" aria-label="مسار التصفح">
        <a asp-action="Index">المستخدمون</a>
        <span aria-hidden="true">/</span>
        <a asp-action="Details" asp-route-id="@Model.UserId">@Model.FullName</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">تعديل</span>
    </nav>

    <h1 class="dash-title">تعديل المستخدم</h1>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="dga-alert dga-alert--danger" role="alert">
            <div>
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@e.ErrorMessage</p>
                }
            </div>
        </div>
    }

    <form method="post" asp-action="Edit" asp-route-id="@Model.UserId">
        <div class="form-section">
            <div class="form-section-body">
                <div class="form-grid cols-2">
                    <div class="field">
                        <label for="fullName">الاسم الكامل <span class="req">*</span></label>
                        <input type="text" id="fullName" name="fullName" value="@Model.FullName" maxlength="200" required />
                    </div>
                    <div class="field">
                        <label for="nationalId">رقم الهوية <span class="req">*</span></label>
                        <input type="text" id="nationalId" name="nationalId" value="@Model.NationalId" inputmode="numeric" maxlength="10" dir="ltr" autocomplete="off" data-latin-digits required />
                    </div>
                    <div class="field">
                        <label for="email">البريد الإلكتروني</label>
                        <input type="email" id="email" name="email" value="@Model.Email" maxlength="200" dir="ltr" />
                    </div>
                    <div class="field">
                        <label for="phone">الجوال</label>
                        <input type="tel" id="phone" name="phone" value="@Model.Phone" inputmode="tel" maxlength="10" dir="ltr" placeholder="05XXXXXXXX" data-latin-digits />
                    </div>
                    <div class="field">
                        <label for="roleId">الدور <span class="req">*</span></label>
                        <select id="roleId" name="roleId" required disabled="@isSelf">
                            @foreach (var r in roles)
                            {
                                <option value="@r.RoleId" selected="@(r.RoleId == Model.RoleId)">@r.RoleName</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label>الحالة <span class="req">*</span></label>
                        <div class="radio-group">
                            <label class="radio-option"><input type="radio" name="isActive" value="true" checked="@Model.IsActive" disabled="@isSelf" /> نشط</label>
                            <label class="radio-option"><input type="radio" name="isActive" value="false" checked="@(!Model.IsActive)" disabled="@isSelf" /> معطّل</label>
                        </div>
                    </div>
                </div>
                @if (isSelf)
                {
                    <input type="hidden" name="roleId" value="@Model.RoleId" />
                    <input type="hidden" name="isActive" value="true" />
                    <small class="field-hint">لا يمكنك تغيير دورك أو تعطيل حسابك.</small>
                }
            </div>
        </div>

        <div class="wizard-nav">
            <div class="wizard-nav-start"><a asp-action="Details" asp-route-id="@Model.UserId" class="dga-btn dga-btn--ghost">إلغاء</a></div>
            <div class="wizard-nav-end"><button type="submit" class="dga-btn dga-btn--primary">حفظ</button></div>
        </div>
    </form>
</div>
